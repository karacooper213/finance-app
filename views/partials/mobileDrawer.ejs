
   <div class="container">
        <div class="card">
            <h1>Finance App</h1>
                <p id="balance">Balance: <%= balance %></p>
                <form action="/transactions" method="POST">
                    <input name="item" id="itemInput" type="text" placeholder="Enter the item"/>
                    <input name="cost" id="amountInput" type="number" placeholder="Enter a positive integer" min="1" />
                    <div>
                        <button id="depositBtn" name ="type" value="Deposit" type="submit" >Deposit</button> 
                        <button id="withdrawBtn" name="type" value="Withdraw" type="submit">Withdraw</button>
                    </div>
                </form>
        </div>
    </div>
   
   