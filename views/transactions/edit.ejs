<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    
    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>
 

<div class="container-list">
    <div class="container">
            <div class="card">
                <div id="container-header">
                     <h1 id="newTransaction">Edit Transaction</h1>
                </div>
                    <form action="/transactions/<%=transaction.id%>?_method=PATCH" method="POST">
                        <div class = "newTransactionFields">
                            <label> Item Name:
                                <input name="item" id="itemInput" type="text" placeholder="Enter the item"/>
                            </label>
                        </div>
                        <div class = "newTransactionFields">
                            <label> Cost Amount:
                                <input name="cost" id="amountInput" type="number" placeholder="Enter the cost" step="0.01" min="0" />
                            </label>
                        </div>
                        <div>
                            <button id="depositBtn" name ="type" value="Deposit" type="submit" >Deposit</button> 
                            <button id="withdrawBtn" name="type" value="Withdraw" type="submit">Withdraw</button>
                        </div>
                    </form>
            </div>
        </div>
    </div>
</div>