<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    
    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>
 

    <div class="container-list">
        <div class="container">
            
                    <div id="container-header">
                        <h1 id="newTransaction">Edit Transaction</h1>
                    </div>
                        <form id="newForm" action="/transactions/<%=transaction._id%>?_method=PUT" method="POST">
                            <div class="itemGroup">
                                <div>
                                    <label for="item">Item</label> 
                                    <input type="text" name="item" placeholder="Item Name" value="<%=transaction.item%>"/>
                                </div>
                                <div>
                                    <label for="amount">$ Amount</label>
                                    <input type="number" name="amount" placeholder="Amount" step="0.01" min="0" value="<%=transaction.amount%>" />
                                </div>
                                <div>
                                    <label for="vendor">Vendor</label>
                                    <input type="text" name="vendor" placeholder="Vendor" value="<%=transaction.vendor%>"/>
                                </div>
                            </div>
                            <div class="itemType">
                                <div>
                                    <label for="transactionType">Transaction Type</label>
                                    <select name="transactionType" id="transactionType" value="<%=transaction.transactionType%>">
                                            <option value="Withdraw"<%=transaction.transactionType === 'Withdraw' ? 'selected': ''%> >Withdraw</option>
                                            <option value="Deposit" <%=transaction.transactionType === 'Deposit' ? 'selected': ''%> >Deposit</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="category">Select Category</label>
                                <select name = "category">
                                    <% categories.forEach(category => { %>
                                        <option value="<%= category._id %>">
                                            <%= category.name %></option>
                                    <% }) %>
                                </select>
                                </div>
                                <div>
                                    <label for="date">Date Purchased</label>
                                    <input type="date" id="date" name="date" value="<%=transaction.date.getUTCFullYear() %>-<%= String(transaction.date.getUTCMonth() + 1).padStart(2, '0') %>-<%= String(transaction.date.getUTCDate()).padStart(2, '0') %>">
                                </div>
                            </div>
                            <div class = "purchaseDetails">
                                <div>
                                    <label for="regret">Did you regret this purchase?</label>
                                    <input type="checkbox" name="regret" <%= transaction.regret ? 'checked' : '' %>/>
                                </div>
                                <div>
                                    <label for="necessity">Was this a want or a need?</label>
                                    <select name="necessity" id="necessity">
                                        <option value='Need' <%=transaction.necessity === 'Need' ? 'selected': ''%>>Need</option>
                                        <option value='Need (Cheaper Option Available)' <%=transaction.necessity === 'Need (Cheaper Option Available)' ? 'selected': ''%>>Need (Cheaper Option Available) </option>
                                        <option value='Want' <%=transaction.necessity === 'Want' ? 'selected': ''%>>Want</option>
                                    </select>
                                </div>
                            </div>
                            <div class="saveTransaction">
                                <button class="submitButton" type="submit">Save Transaction</button>
                            </div>
                        </form>
            
            </div>
        </div>
    </div>
</body>
