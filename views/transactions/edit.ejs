<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    
    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>
 

    <div class="container-list">
        <div class="container">
            
                    <div id="container-header">
                        <h1 id="newTransaction">Edit Transaction</h1>
                    </div>
                        <form id="newForm" action="/transactions/<%=transaction._id%>?_method=PUT" method="POST">
                            <div class="itemGroup">
                                <div>
                                    <label for="item">Item</label> 
                                    <input type="text" name="item" placeholder="Item Name" value="<%=transaction.item%>"/>
                                </div>
                                <div>
                                    <label for="amount">$ Amount</label>
                                    <input type="number" name="amount" placeholder="Amount" step="0.01" min="0" value="<%=transaction.amount%>" />
                                </div>
                                <div>
                                    <label for="vendor">Vendor</label>
                                    <input type="text" name="vendor" placeholder="Vendor" value="<%=transaction.vendor%>"/>
                                </div>
                            </div>
                            <div class="itemType">
                                <div>
                                    <label for="transactionType">Transaction Type</label>
                                    <select name="transactionType" id="transactionType" value="<%=transaction.transactionType%>">
                                            <option value="Withdraw"<%=transaction.transactionType === 'Withdraw' ? 'selected': ''%> >Withdraw</option>
                                            <option value="Deposit" <%=transaction.transactionType === 'Deposit' ? 'selected': ''%> >Deposit</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="category">Select Category</label>
                                    <select name="category" id="category" value="<%=transaction.category%>">
                                        <option value="Income" <%=transaction.category === 'Income' ? 'selected': ''%>>Income</option>
                                        <option value="Housing" <%=transaction.category === 'Housing' ? 'selected': ''%>>Housing</option>
                                        <option value="Food"<%=transaction.category === 'Food' ? 'selected': ''%>>Food</option>
                                        <option value="Transportation" <%=transaction.category === 'Transportation' ? 'selected': ''%>>Transportation</option>
                                        <option value="Utilities" <%=transaction.category === 'Utilities' ? 'selected': ''%>>Utilities</option>
                                        <option value="Insurance" <%=transaction.category === 'Insurance' ? 'selected': ''%>>Insurance</option>
                                        <option value="Medical & Healthcare"<%=transaction.category === 'Medical & Healthcare' ? 'selected': ''%> >Medical & Healthcare</option>
                                        <option value="Debt" <%=transaction.category === 'Debt' ? 'selected': ''%>>Debt</option>
                                        <option value="Savings" <%=transaction.category === 'Savings' ? 'selected': ''%>>Savings</option>
                                        <option value="Education" <%=transaction.category === 'Education' ? 'selected': ''%>>Education</option>
                                        <option value="Fun" <%=transaction.category === 'Fun' ? 'selected': ''%>>Fun</option>
                                        <option value="Household Supplies" <%=transaction.category === 'Household Supplies' ? 'selected': ''%>>Household Supplies</option>
                                        <option value="Misc">Misc</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="date">Date Purchased</label>
                                    <input type="date" id="date" name="date" value="<%=transaction.date.getUTCFullYear() %>-<%= String(transaction.date.getUTCMonth() + 1).padStart(2, '0') %>-<%= String(transaction.date.getUTCDate()).padStart(2, '0') %>">
                                </div>
                            </div>
                            <div class = "purchaseDetails">
                                <div>
                                    <label for="regret">Did you regret this purchase?</label>
                                    <input type="checkbox" name="regret" <%= transaction.regret ? 'checked' : '' %>/>
                                </div>
                            
                            </div>
                            <div class="saveTransaction">
                                <button class="submitButton" type="submit">Save Transaction</button>
                            </div>
                        </form>
            
            </div>
        </div>
    </div>
</body>
