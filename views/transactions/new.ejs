<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    
    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>
   
   <div class ="container-list">
    <div class="container">
            
                <div id = "container-header">
                         <h1 id="newTransaction">New Transaction</h1>
                </div>
                    <form id="newForm" action="/transactions" method="POST">
                        <div class="itemGroup">
                            <div>
                                <label for="item">Item Purchased</label> 
                                <input type="text" name="item" placeholder="Item Name"/>
                            </div>
                            <div>
                                <label for="amount">$ Amount</label>
                                <input type="number" name="amount" placeholder="Amount" step="0.01" min="0" />
                            </div>
                            <div>
                                <label for="vendor">Vendor</label>
                                <input type="text" name="vendor" placeholder="Vendor"/>
                            </div>
                        </div>
                        <div class="itemType">
                            <div>
                                <label for="transactionType">Transaction Type</label>
                                <select name="transactionType" id="transactionType">
                                        <option value="Withdraw">Withdraw</option>
                                        <option value="Deposit">Deposit</option>
                                </select>
                            </div>
                            <div>
                                <label for="category">Select Category</label>
                                <select name="category" id="category">
                                    <option value="Housing">Housing</option>
                                    <option value="Food">Food</option>
                                    <option value="Transportation">Transportation</option>
                                    <option value="Utilities">Utilities</option>
                                    <option value="Insurance">Insurance</option>
                                    <option value="Medical & Healthcare">Medical & Healthcare</option>
                                    <option value="Debt">Debt</option>
                                    <option value="Savings">Savings</option>
                                    <option value="Education">Education</option>
                                    <option value="Fun">Fun</option>
                                    <option value="Household Supplies">Household Supplies</option>
                                    <option value="Misc">Misc</option>
                                </select>
                            </div>
                              <div>
                                <label for="date">Date Purchased</label>
                                <input type="date" id="date" name="date">
                            </div>
                         </div>
                         <div class = "purchaseDetails">
                            <div>
                                <label for="regret">Did you regret this purchase?</label>
                                <input type="checkbox" name="regret"/>
                            </div>
                          
                        </div>
                        <div class="saveTransaction">
                            <button class="submitButton" type="submit">Save Transaction</button>
                        </div>
                    </form>
            
        </div>
    </div>
</div>
</body>
