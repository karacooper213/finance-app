<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AnalysisHome</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>
    
    <%- include('../partials/sidebar') %>
  
    <%- include('../partials/navbar') %>

          
    <div class="container-list">
       <div class="container-analysis">
            <div id="analysisTitles">
                <h1>Spending Analysis</h1>
                <p>Target Calculation & Recommendations</p> 
            </div>
            <div class="pageImages" id="foxTarget"> <img src="/images/targets2.png"></div>
        </div>
        <div id="analysisCards">
            <div id="totalIncome" class="summaryBlocks">
                <div class="line" id="totalIncomeColor" >
                </div>
                <div class="totalTitle">
                    <h2>Total Income</h2>
                </div>
                <h2>$<%= totalIncome %></h2>
            </div>

            <div id="totalSpending" class="summaryBlocks">
                <div class="line" id="totalSpendingColor">
                </div>
                <div class="totalTitle">
                    <h2>Total Spending</h2>
                </div>
               <h2>$<%= totalSpending %></h2>
            </div>

            <div id="netSavings" class="summaryBlocks">
                <div class="line" id="netSavingsColor" >
                </div>
                <div class="totalTitle">
                    <h2>Net Savings</h2>
                </div>
                <h2>$<%= netSavings %></h2>
            </div>

            <div id="regretRate" class="summaryBlocks">
                <div class="line" id="regretRateColor">
                </div>
                <div class="totalTitle">
                    <h2>Regret Rate</h2>
                </div>
                <h2><%= regretRateRounded %>%</h2> 
            </div>
        </div>

        <div id="doughnutGraph">
            <h2>Spending by Category</h2>
            <canvas
                     id="myChart" width = "500">
             </canvas>

       

        </div>
            <script
                src="https://cdn.jsdelivr.net/npm/chart.js@4.5.0">
            </script>
            
            <script>
                    const labels = <%- JSON.stringify(labels) %>;
                    const yValues = <%- JSON.stringify(totals) %>;

                    const barColors = [
                            "#1F2B3A", 
                            "#DD4318", 
                            "#2CA02C", 
                            "#1F77B4", 
                            "#FF7F0E", 
                            "#9467BD", 
                            "#E377C2", 
                            "#D62728", 
                            "#17BECF", 
                            "#8C564B", 
                            "#F28E2B",
                            "#BCBD22",
                            "#59A14F", 
                           
                    ]

                    new Chart("myChart", {
                        type: "doughnut",
                        data: {
                            labels: labels,
                            datasets: [{
                                backgroundColor: barColors,
                                data: yValues
                            }]
                        },
                        options: {
                            responsive: false,
                           
                        }
                    });

                    function resize() {
                        myChart.resize(600, 450);
                    }
            </script>
     
     </div>
    </div>
  
</body>
</html>
