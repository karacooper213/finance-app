<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AnalysisHome</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>
    
    <%- include('../partials/sidebar') %>
  
    <%- include('../partials/navbar') %>

          
    <div class="container-list">
       <div class="container-analysis">
            <div id="analysisTitles">
                <h1>Spending Analysis</h1>
                <p>Target Calculation & Recommendations</p> 
            </div>
            <div class="pageImages" id="foxTarget"> <img src="/images/targets2.png"></div>
        </div>
        <div id="analysisCards">
            <div id="totalIncome" class="summaryBlocks">
                <div class="line" id="totalIncomeColor" >
                </div>
                 <i class="fa-solid fa-wallet"></i>
                    <div class="summaryBlockTitles">
                        <div class="totalTitle">
                            <h2>Total Income</h2>
                            <h3>Previous three months</h3>
                        </div>
                        
                            <h2>$<%= totalIncome %></h2>
                       
                    </div>
                </div>
            

            <div id="totalSpending" class="summaryBlocks">
                <div class="line" id="totalSpendingColor">
                </div>
                <i class="fa-solid fa-credit-card"></i>
                <div class="summaryBlockTitles">
                    <div class="totalTitle">
                        <h2>Total Spending</h2>
                        <h3>Previous three months</h3>
                    </div>
                
               
                    <h2>$<%= totalSpending %></h2>
                    </div>
               
            </div>

            <div id="netSavings" class="summaryBlocks">
                <div class="line" id="netSavingsColor" >
                </div>
                <i class="fa-solid fa-piggy-bank"></i>
                <div class="summaryBlockTitles">
                    <div class="totalTitle">
                        <h2>Net Savings</h2>
                        <h3>Previous three months</h3>
                    </div>
                    <h2>$<%= netSavings %></h2>
                </div>
                
            </div>

            <div id="regretRate" class="summaryBlocks">
                <div class="line" id="regretRateColor">
                </div>
                <i class="fa solid fa-triangle-exclamation"></i>
                    <div class="summaryBlockTitles">
                        <div class="totalTitle">
                            <h2>Regret Rate</h2>
                            <h3>Previous three months</h3>
                        </div>
                       <h2><%= regretRateRounded %>%</h2>   
                    </div>
                
            </div>
        </div>
        <div id="charts">
            <div id ="includeTable">
                <div id="doughnutGraph">
                    <div id="doughnutTitle">
                        <h2>Spending by Category</h2>
                    </div>
                    <div class="doughnut-chart-box">
                        <canvas
                                id="myChart" >
                        </canvas>
                    </div>
             </div>

                <div>
                    <script
                        src="https://cdn.jsdelivr.net/npm/chart.js@4.5.0">
                    </script>
                    
                    <script>
                            const labels2 = <%- JSON.stringify(labels) %>;
                            const yValues = <%- JSON.stringify(totals) %>;

                            const barColors = [
                                    "#1F2B3A", 
                                    "#DD4318", 
                                    "#2CA02C", 
                                    "#1F77B4", 
                                    "#FF7F0E", 
                                    "#9467BD", 
                                    "#E377C2", 
                                    "#D62728", 
                                    "#17BECF", 
                                    "#8C564B", 
                                    "#F28E2B",
                                    "#BCBD22",
                                    "#59A14F", 
                                
                            ]

                            new Chart("myChart", {
                                type: "doughnut",
                                data: {
                                    labels: labels2,
                                    datasets: [{
                                        backgroundColor: barColors,
                                        data: yValues
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    plugins: {
                                        legend: {
                                            position: 'right'
                                        }
                                    }
                                }
                            });

                          
                    </script>
            
            
                </div>
               
                <table id ="targetCalculationTable">
                    <thead>
                        <tr>
                            <th scope="col">Category</th>
                            <th scope="col">Current spending</th>
                            <th scope="col">Target Recommendation</th>
                            <th scope="col">Difference</th>
                        </tr>
                    </thead>
                    <tbody> 
                            <% for (let i=0; i<labels.length; i++) {%>
                                <tr>
                                        <td><%= labels[i] %> </td>
                                        <td><%= totals[i] %> </td>
                                        <td><%= targetRecommendations[i] %> </td>
                                        <td><%= differences[i] %> </td>
                                </tr>
                            <% } %>
                    </tbody>
                </table>
        </div>
            </div>
                <div id="barGraph">
                    <div id="barGraphTitle">
                        <h2>Regret Rate by Category</h2>
                    </div>
                    <div class="bar-chart-box">
                        <canvas
                                id="myChart2" >
                        </canvas>
                    </div>

            

                </div>
                <div>
            
                    <script>
                            const labels3 = <%- JSON.stringify(labels) %>;
                            const yValues3 = <%- JSON.stringify(regretRates) %>;

                            const barColors2 = [
                                    "#1F2B3A", 
                                    "#DD4318", 
                                    "#2CA02C", 
                                    "#1F77B4", 
                                    "#FF7F0E", 
                                    "#9467BD", 
                                    "#E377C2", 
                                    "#D62728", 
                                    "#17BECF", 
                                    "#8C564B", 
                                    "#F28E2B",
                                    "#BCBD22",
                                    "#59A14F", 
                                
                            ]

                            new Chart("myChart2", {
                                type: "bar",
                                data: {
                                    labels: labels3,
                                    datasets: [{
                                        backgroundColor: barColors2,
                                        data: yValues3
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    scales: {
                                        y: {
                                            beginAtZero: true
                                        }
                                    },
                                    maintainAspectRatio: false,
                                    plugins: {
                                        legend: {
                                            display: false
                                        }
                                    }
                                    
                                    
                                
                                }
                                

                            
                            });
                           
                          
                    </script>
            </div>
        </div>
       
    </div>


  
</body>
</html>
